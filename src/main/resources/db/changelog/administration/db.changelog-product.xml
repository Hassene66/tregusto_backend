<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="categories-table-001" author="Hassene">
        <createTable tableName="categories">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_categories_slug" tableName="categories">
            <column name="slug"/>
        </createIndex>
        <createIndex indexName="idx_categories_is_active" tableName="categories">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <changeSet id="products-table-001" author="Hassene">
        <createTable tableName="products">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(200)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="short_description" type="VARCHAR(255)"/>
            <column name="long_description" type="TEXT"/>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="default">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="DECIMAL(3,2)" defaultValueNumeric="0"/>
            <column name="main_image_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_products_category" references="categories(id)"/>
            </column>
            <column name="is_available" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_products_slug" tableName="products">
            <column name="slug"/>
        </createIndex>
        <createIndex indexName="idx_products_category_id" tableName="products">
            <column name="category_id"/>
        </createIndex>
        <createIndex indexName="idx_products_status" tableName="products">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_products_is_available" tableName="products">
            <column name="is_available"/>
        </createIndex>
    </changeSet>

    <changeSet id="product-images-table-001" author="Hassene">
        <createTable tableName="product_images">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_product_images_product" references="products(id)"/>
            </column>
            <column name="image_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="alt_text" type="VARCHAR(255)"/>
            <column name="display_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_product_images_product_id" tableName="product_images">
            <column name="product_id"/>
        </createIndex>
        <createIndex indexName="idx_product_images_display_order" tableName="product_images">
            <column name="display_order"/>
        </createIndex>
    </changeSet>

    <changeSet id="ingredient-categories-table-001" author="Hassene">
        <createTable tableName="ingredient_categories">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="ingredient_categories">
            <column name="name" value="Viande"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Fromage"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Legume"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Sauce"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Herbe"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Epice"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Pain"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Base"/>
        </insert>
        <insert tableName="ingredient_categories">
            <column name="name" value="Autre"/>
        </insert>
    </changeSet>

    <changeSet id="ingredients-table-001" author="Hassene">
        <createTable tableName="ingredients">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_ingredients_category" references="ingredient_categories(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_ingredients_slug" tableName="ingredients">
            <column name="slug"/>
        </createIndex>
        <createIndex indexName="idx_ingredients_category_id" tableName="ingredients">
            <column name="category_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="product-ingredients-table-001" author="Hassene">
        <createTable tableName="product_ingredients">
            <column name="product_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_product_ingredients_product" references="products(id)"/>
            </column>
            <column name="ingredient_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_product_ingredients_ingredient" references="ingredients(id)"/>
            </column>
            <column name="quantity" type="VARCHAR(50)"/>
            <column name="display_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_optional" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="product_ingredients" columnNames="product_id, ingredient_id"/>
        <createIndex indexName="idx_product_ingredients_product_id" tableName="product_ingredients">
            <column name="product_id"/>
        </createIndex>
        <createIndex indexName="idx_product_ingredients_ingredient_id" tableName="product_ingredients">
            <column name="ingredient_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
