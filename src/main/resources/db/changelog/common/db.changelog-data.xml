<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <!-- ======================================== -->
    <!-- CATEGORIES -->
    <!-- ======================================== -->
    <changeSet id="1-insert-categories" author="Hassene">
        <insert tableName="categories">
            <column name="name" value="Pizzas"/>
            <column name="slug" value="pizzas"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="image_url" value="/img/category/icon/pizzas.png"/>
        </insert>
        <insert tableName="categories">
            <column name="name" value="Burgers"/>
            <column name="slug" value="burgers"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="image_url" value="/img/category/icon/burgers.png"/>
        </insert>
        <insert tableName="categories">
            <column name="name" value="Sandwichs"/>
            <column name="slug" value="sandwichs"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="image_url" value="/img/category/icon/sandwichs.png"/>
        </insert>
        <insert tableName="categories">
            <column name="name" value="Boissons"/>
            <column name="slug" value="boissons"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="image_url" value="/img/category/icon/boissons.png"/>
        </insert>
        <insert tableName="categories">
            <column name="name" value="Desserts"/>
            <column name="slug" value="desserts"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="image_url" value="/img/category/icon/salades.png"/>
        </insert>
    </changeSet>

    <!-- ======================================== -->
    <!-- PRODUCTS -->
    <!-- ======================================== -->
    <changeSet id="2-insert-products" author="Hassene">

        <insert tableName="products">
            <column name="name" value="Pizza Margherita"/>
            <column name="slug" value="pizza-margherita"/>
            <column name="price" valueNumeric="12.99"/>
            <column name="status" value="POPULAR"/>
            <column name="rating" valueNumeric="4.8"/>
            <column name="category_id" valueNumeric="1"/>
            <column name="is_available" valueBoolean="true"/>
        </insert>

        <insert tableName="products">
            <column name="name" value="Pizza Pepperoni"/>
            <column name="slug" value="pizza-pepperoni"/>
            <column name="price" valueNumeric="14.99"/>
            <column name="status" value="POPULAR"/>
            <column name="rating" valueNumeric="4.7"/>
            <column name="category_id" valueNumeric="1"/>
            <column name="is_available" valueBoolean="true"/>
        </insert>

        <insert tableName="products">
            <column name="name" value="Burger Classic"/>
            <column name="slug" value="burger-classic"/>
            <column name="price" valueNumeric="11.99"/>
            <column name="status" value="POPULAR"/>
            <column name="rating" valueNumeric="4.6"/>
            <column name="category_id" valueNumeric="2"/>
            <column name="is_available" valueBoolean="true"/>
        </insert>

    </changeSet>

    <!-- ======================================== -->
    <!-- INGREDIENTS -->
    <!-- ======================================== -->
    <changeSet id="3-insert-ingredients" author="Hassene">

        <insert tableName="ingredients">
            <column name="name" value="Mozzarella"/>
            <column name="slug" value="mozzarella"/>
            <column name="category_id" valueNumeric="2"/>
        </insert>

        <insert tableName="ingredients">
            <column name="name" value="Sauce tomate"/>
            <column name="slug" value="sauce-tomate"/>
            <column name="category_id" valueNumeric="4"/>
        </insert>

        <insert tableName="ingredients">
            <column name="name" value="Pâte à pizza"/>
            <column name="slug" value="pate-a-pizza"/>
            <column name="category_id" valueNumeric="1"/>
        </insert>

        <insert tableName="ingredients">
            <column name="name" value="Pepperoni"/>
            <column name="slug" value="pepperoni"/>
            <column name="category_id" valueNumeric="1"/>
        </insert>

    </changeSet>

    <!-- ======================================== -->
    <!-- PRODUCT INGREDIENTS -->
    <!-- ======================================== -->
    <changeSet id="4-product-ingredients" author="Hassene">
        <!-- safer inserts by slug -->
        <sql>
            INSERT INTO product_ingredients (product_id, ingredient_id, quantity, display_order, is_optional)
            SELECT p.id, i.id, '1 portion', 1, false
            FROM products p
                     JOIN ingredients i ON i.slug='pate-a-pizza'
            WHERE p.slug='pizza-margherita';
        </sql>

        <sql>
            INSERT INTO product_ingredients
            SELECT p.id, i.id, '100g', 2, false
            FROM products p
                     JOIN ingredients i ON i.slug='sauce-tomate'
            WHERE p.slug='pizza-margherita';
        </sql>

        <sql>
            INSERT INTO product_ingredients
            SELECT p.id, i.id, '150g', 3, false
            FROM products p
                     JOIN ingredients i ON i.slug='mozzarella'
            WHERE p.slug='pizza-margherita';
        </sql>

        <sql>
            INSERT INTO product_ingredients
            SELECT p.id, i.id, '80g', 4, false
            FROM products p
                     JOIN ingredients i ON i.slug='pepperoni'
            WHERE p.slug='pizza-pepperoni';
        </sql>

    </changeSet>

</databaseChangeLog>